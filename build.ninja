rule cc
    command = $toolchain $cflags -MD -MF $out.d -c -o $out $in 
    depfile = $out.d
    description = $in

rule link
    command = $toolchain -o $out $in $ldflags

cflags = -g
ldflags = -lm

toolchain = clang

outdir = .build

build $outdir/string.o: cc src/string/compile.c
build $outdir/measure.o: cc src/measure/timing.c
build $outdir/main.o: cc src/main.c
build $outdir/alloc.o: cc src/alloc/compile.c

build $outdir/main: link $outdir/string.o $
                         $outdir/measure.o $
                         $outdir/alloc.o $
                         $outdir/main.o
